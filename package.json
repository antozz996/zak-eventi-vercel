{
  "name": "zak-eventi-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check:visual": "node scripts/visual-check.mjs",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "check:site": "node scripts/build-worker.mjs && node scripts/check-site.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0",
    "typescript": "~5.7.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wouter": "^3.7.1",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.2",
    "ws": "^8.18.0"
  }
}
